module Haskimail
  # @api private
  module Redacted : Object
    def encode_with: (untyped coder) -> void
    def marshal_dump: () -> bot
    def as_json: (*untyped) -> String
    def to_json: (*untyped args) -> String
  end

  class BaseClient
    include Redacted
  end

  module HTTP
    class Request
      include Redacted
    end

    class NetHttpTransport
      include Redacted
    end
  end

  module Resources
    class Base
      include Redacted
    end
  end
